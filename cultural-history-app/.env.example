# Copy to .env ONLY if you need to override defaults. Do not commit .env.
#
# Docker mode (docker compose up -d --build): values come from the
# `environment:` section in docker-compose.yml — no .env file needed.
#
# Host mode (uvicorn on this machine, SearXNG on localhost:8888,
# LM Studio on localhost:1234): config.py defaults already match, so
# no .env file is needed either. Uncomment and edit only to override:

# DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# SEARXNG_BASE_URL=http://localhost:8888
# LM_STUDIO_BASE_URL=http://localhost:1234
# LM_STUDIO_MODEL=meta-llama-3.1-8b-instruct
# OPENSERP_BASE_URL=http://localhost:7000
# OPENSERP_ENGINES=google,yandex,duckduckgo
# OPENSERP_MODE=balanced
# SEARCH_MAX_PAGES=3
# SEARCH_DELAY=1.5
# OPENSERP_RESULTS_LIMIT=30
# DEFAULT_SEARCH_ENGINE=openserp   # or searxng; preselected in the UI and used when a request omits it
# SCRAPER_VERIFY_SSL=false         # true to verify TLS certificates when fetching pages
# LLM_TEXT_LIMIT=3000              # characters of page text sent to the LLM
# FETCH_CONCURRENCY=3              # parallel page fetches within one analysis
# SEARXNG_SECRET=                  # generated by scripts/start.sh and start.ps1 if missing
# YANDEX_API_KEY=                  # required for the Yandex provider (never sent from the UI)
# YANDEX_FOLDER_ID=                # Cloud folder for gpt://<folder>/<model> (UI + server fallback)
# YANDEX_ENDPOINT=https://ai.api.cloud.yandex.net/v1
# YANDEX_MODEL=qwen3-235b-a22b-fp8
